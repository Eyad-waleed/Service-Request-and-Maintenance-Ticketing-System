@page
@model Service_Request_and_Maintenance_Ticketing_System.Pages.TicketCategoryPages.EditModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>TicketCategory</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="TicketCategory.Id" />
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="TicketCategory.Name" class="control-label"></label>
                <input asp-for="TicketCategory.Name" class="form-control" aria-required="true"/>
                <span asp-validation-for="TicketCategory.Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="TicketCategory.Description" class="control-label"></label>
                <input asp-for="TicketCategory.Description" class="form-control" />
                <span asp-validation-for="TicketCategory.Description" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="TicketCategory.IsActive" class="control-label"></label>
                <input asp-for="TicketCategory.IsActive" class="form-check-input" />
                <span asp-validation-for="TicketCategory.IsActive" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
